# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (defaults to 3000)
PORT=3000

# JWT Access & Refresh signing secrets (set strong random strings in production)
AUTH_SECRET="change-me-in-production-access-secret"
REFRESH_SECRET="change-me-in-production-refresh-secret"

# Optional custom path for persisted SmartQueue JSON store
SMARTQUEUE_DB_PATH=".data/smartqueue-db.json"

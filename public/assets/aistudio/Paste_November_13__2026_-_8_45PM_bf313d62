      document.getElementById('lblGetToken').innerText = dict.getToken;
      document.getElementById('lblFreePlanner').innerText = dict.freePlanner;
      document.getElementById('locName').innerText = dict.hospital;
      document.getElementById('trustScoreVal').innerText = `${STATE.trustScore} ${dict.trust}`;
      showToast(`Language switched to ${lang === 'te' ? 'తెలుగు' : lang === 'hi' ? 'हिंदी' : 'English'}`);
    }

    // Role Switcher
    function switchRole(role) {
      STATE.role = role;
      document.getElementById('roleCitizen').classList.toggle('active', role === 'citizen');
      document.getElementById('roleOrg').classList.toggle('active', role === 'org');
      document.getElementById('viewCitizen').classList.toggle('hidden', role !== 'citizen');
      document.getElementById('viewOrg').classList.toggle('hidden', role !== 'org');
    }

    // Select Service Category
    function selectService(elem, prefix, name, waitMins, serving, myTurn) {
      document.querySelectorAll('.service-card').forEach(el => el.classList.remove('selected'));
      elem.classList.add('selected');
      STATE.tokenPrefix = prefix;
      STATE.serviceName = name;
      STATE.estMinutes = waitMins;
      STATE.servingNumber = serving;
      STATE.myTurnNumber = myTurn;
      STATE.tokenNumber = `${prefix}-${myTurn}`;
    }

    // Join Queue Action
    function joinQueueAction() {
      STATE.hasToken = true;
      document.getElementById('screenJoin').classList.add('hidden');
      document.getElementById('screenLiveToken').classList.remove('hidden');
      document.getElementById('lblTokenCategory').innerText = STATE.serviceName.toUpperCase();
      updateCitizenDisplays();
      showToast(`🎟️ Token ${STATE.tokenNumber} issued! Return notifications active.`);
    }

    // Offline Join Simulation
    function simulateOfflineJoin(method) {
      selectService(document.querySelector('.service-card.selected'), 'A', 'General OPD • Room 104', 18, 36, 42);
      joinQueueAction();
      showToast(`📱 Simulated Offline Token issued via ${method}!`);
    }

    // Cancel Queue
    function cancelQueue() {
      STATE.hasToken = false;
      document.getElementById('screenLiveToken').classList.add('hidden');
      document.getElementById('screenJoin').classList.remove('hidden');
      if (graceInterval) {
        clearInterval(graceInterval);
        graceInterval = null;
      }
      document.getElementById('graceBanner').classList.remove('active');
      showToast("Token canceled. Capacity freed for other citizens.");
    }

    // Update Citizen Displays
    function updateCitizenDisplays() {
      const ahead = STATE.myTurnNumber - STATE.servingNumber;
      document.getElementById('currServing').innerText = `${STATE.tokenPrefix}-${STATE.servingNumber}`;
      document.getElementById('myTokenId').innerText = STATE.tokenNumber;

      const waitBadge = document.getElementById('waitMinutes');
      const returnTimeLabel = document.getElementById('returnTimeTarget');
      const progress = document.getElementById('returnProgress');
      const returnGuidance = document.getElementById('returnGuidance');
      const plannerTag = document.getElementById('plannerWindowTag');
      const freeTitle = document.getElementById('freeMinTitle');

      if (ahead > 0) {
        const estRemaining = Math.max(2, Math.round(ahead * 3.5));
        waitBadge.innerText = `${estRemaining} min`;
        waitBadge.style.color = "var(--amber)";
        document.getElementById('tokenStatusText').innerText = `Position in line: ${ahead} person${ahead > 1 ? 's' : ''} ahead`;
        
        const now = new Date();
        const returnTime = new Date(now.getTime() + Math.max(1, estRemaining - 3) * 60000);
        const hours = returnTime.getHours() % 12 || 12;
        const minutes = returnTime.getMinutes().toString().padStart(2, '0');
        const ampm = returnTime.getHours() >= 12 ? 'PM' : 'AM';
        returnTimeLabel.innerText = `Return by ${hours}:${minutes} ${ampm}`;
        
        const pct = Math.min(100, Math.max(15, Math.round((ahead / 6) * 100)));
        if (progress) progress.style.width = `${pct}%`;
        returnGuidance.innerText = `Mock push will buzz phone 5 mins before Counter 2 calls ${STATE.tokenNumber}.`;

        if (plannerTag) plannerTag.innerText = `Window: ~${estRemaining} Free Minutes`;
        if (freeTitle) freeTitle.innerText = `You have ${estRemaining} productive minutes!`;
      } else {
        // It is the user's turn
        waitBadge.innerText = `0 min (NOW)`;
        waitBadge.style.color = "var(--green)";
        document.getElementById('tokenStatusText').innerText = `🚨 IT'S YOUR TURN! Report to Counter 2`;
        returnTimeLabel.innerText = `REPORT IMMEDIATELY`;
        if (progress) progress.style.width = `100%`;
        returnGuidance.innerText = `🔔 Attention: Token ${STATE.tokenNumber} is being called now at Counter 2.`;
        if (plannerTag) plannerTag.innerText = `Window Expired`;
        if (freeTitle) freeTitle.innerText = `Your turn has arrived!`;
      }
    }

    // Voice Accessibility
    function readAloudToken() {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const ahead = STATE.myTurnNumber - STATE.servingNumber;
        const msg = ahead <= 0
          ? `Attention. Token ${STATE.tokenNumber}, please report to Counter 2 immediately.`
          : `Attention please. Now serving token ${STATE.tokenPrefix} ${STATE.servingNumber} at Counter 2. Your token is ${STATE.tokenNumber}. You have ${ahead} people ahead.`;
        
        const utter = new SpeechSynthesisUtterance(msg);
        utter.rate = 0.95;
        if (STATE.language === 'hi') utter.lang = 'hi-IN';
        else if (STATE.language === 'te') utter.lang = 'te-IN';
        else utter.lang = 'en-IN';

        window.speechSynthesis.speak(utter);
        showToast("🔊 Playing accessibility announcement...");
      } else {
        showToast("🔊 Speech not supported on this browser.");
      }
    }

    // Toast with debounce
    function showToast(msg) {
      const toast = document.getElementById('toast');
      document.getElementById('toastMsg').innerText = msg;
      toast.classList.add('show');
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.remove('show');
      }, 3400);
    }

    // Peer Token Swap
    function triggerSwapAction() {
      if (STATE.swapAccepted) return;
      STATE.swapAccepted = true;
      STATE.tokenNumber = `${STATE.tokenPrefix}-39`;
      STATE.myTurnNumber = 39;
      STATE.trustScore += 20;
      document.getElementById('trustScoreVal').innerText = `${STATE.trustScore} Trust`;
      
      const btn = document.getElementById('btnSwapAction');
      btn.innerText = "Swapped ✅";
      btn.disabled = true;
      document.getElementById('swapPeerDesc').innerText = "Swap executed: position updated!";
      
      updateCitizenDisplays();
      showToast("🎉 Swap confirmed with Ramesh K.! You are now Token A-39 (+20 Karma Pts).");
    }

    // AI Reallocation
    function acceptReallocation() {
      STATE.counter3Open = true;
      document.getElementById('aiReallocBanner').style.display = 'none';
      document.getElementById('c3Badge').className = 'counter-badge status-open';
      document.getElementById('c3Name').innerText = 'Counter 3: Dr. Anita Rao';
      document.getElementById('c3Role').innerText = 'General OPD Overflow • Serving A-37';
      document.getElementById('c3Status').innerText = 'Open';
      document.getElementById('c3Status').style.color = 'var(--green)';
      document.getElementById('orgActiveCounters').innerText = '3 / 4';
      document.getElementById('orgAvgWait').innerText = '9m';
      showToast("✅ Counter 3 opened! Queue wait time reduced by 35%.");
    }

    // Interactive Counter Clicker in Org View
    function toggleCounterStatus(counterId) {
      if (counterId === 'c1') {
        const el = document.getElementById('c1Status');
        const badge = el.previousElementSibling.querySelector('.counter-badge');
        if (el.innerText.includes('Busy')) {
          el.innerText = 'Serving';
          el.style.color = 'var(--green)';
          badge.className = 'counter-badge status-open';
        } else {
          el.innerText = 'Busy (2m)';
          el.style.color = 'var(--amber)';
          badge.className = 'counter-badge status-busy';
        }
      } else if (counterId === 'c3') {
        acceptReallocation();
      }
    }

    // Grace Period Logic
    function demoTriggerGrace() {
      if (!STATE.hasToken) joinQueueAction();
      STATE.graceActive = true;
      const banner = document.getElementById('graceBanner');
      banner.classList.add('active');
      banner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      if (graceInterval) clearInterval(graceInterval);

      let secLeft = 299;
      graceInterval = setInterval(() => {
        secLeft--;
        const m = Math.floor(secLeft / 60).toString().padStart(2, '0');
        const s = (secLeft % 60).toString().padStart(2, '0');
        const badge = document.getElementById('graceCountdown');
        if (badge) badge.innerText = `${m}:${s}`;
        if (secLeft <= 0 || !STATE.graceActive) {
          clearInterval(graceInterval);
          graceInterval = null;
        }
      }, 1000);

      showToast("⏳ Missed Turn! 5-minute grace window active.");
    }

    function claimGraceTurn() {
      STATE.graceActive = false;
      if (graceInterval) {
        clearInterval(graceInterval);
        graceInterval = null;
      }
      document.getElementById('graceBanner').classList.remove('active');
      showToast("✅ Welcome back! Your token has been checked-in with the doctor.");
    }

    // Demo Controls
    function demoCallNext() {
      if (!STATE.hasToken) joinQueueAction();
      if (STATE.servingNumber < STATE.myTurnNumber) {
        STATE.servingNumber++;
        updateCitizenDisplays();
        showToast(`📢 Token called: ${STATE.tokenPrefix}-${STATE.servingNumber} at Counter 2`);

        if (STATE.servingNumber === STATE.myTurnNumber) {
          showToast(`🚨 IT'S YOUR TURN! Report to Counter 2 with Token ${STATE.tokenNumber}`);
          readAloudToken();
        }
      } else {
        showToast("Queue has already reached your token.");
      }
    }

    function demoTriggerSwap() {
      if (!STATE.hasToken) joinQueueAction();
      STATE.swapAccepted = false;
      const btn = document.getElementById('btnSwapAction');
      btn.innerText = "Accept Swap";
      btn.disabled = false;
      document.getElementById('swapPeerDesc').innerText = "Offered swap: moves you +3 turns ahead";
      showToast("📩 Peer Swap Request: Ramesh K. (Token A-39) wants to swap!");
      document.querySelector('.swap-card').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function demoReset() {
      if (graceInterval) {
        clearInterval(graceInterval);
        graceInterval = null;
      }
      STATE.tokenPrefix = 'A';
      STATE.servingNumber = 36;
      STATE.myTurnNumber = 42;
      STATE.tokenNumber = 'A-42';
      STATE.serviceName = 'General OPD • Room 104';
      STATE.trustScore = 98;
      STATE.graceActive = false;
      STATE.counter3Open = false;
      STATE.swapAccepted = false;

      document.getElementById('graceBanner').classList.remove('active');
      document.getElementById('aiReallocBanner').style.display = 'block';
      document.getElementById('c3Badge').className = 'counter-badge status-closed';
      document.getElementById('c3Name').innerText = 'Counter 3: Staff Standby';
      document.getElementById('c3Role').innerText = 'General OPD Overflow • Closed';
      document.getElementById('c3Status').innerText = 'Closed';
      document.getElementById('c3Status').style.color = 'var(--red)';
      document.getElementById('orgActiveCounters').innerText = '2 / 4';
      document.getElementById('orgAvgWait').innerText = '14m';
      document.getElementById('trustScoreVal').innerText = '98 Trust';

      const btn = document.getElementById('btnSwapAction');
      btn.innerText = "Accept Swap";
      btn.disabled = false;

      joinQueueAction();
      showToast("🔄 Prototype reset to initial demo parameters.");
    }
  </script>
</body>
</html>
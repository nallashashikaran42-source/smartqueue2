<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SmartQueue – Don't Wait. Use the Wait.</title>
  <style>
    :root {
      --primary: #028090;
      --primary-dark: #00606e;
      --primary-light: #e0f2f1;
      --secondary: #00a896;
      --navy: #0b2545;
      --navy-light: #134074;
      --amber: #f4a261;
      --amber-dark: #c86b28;
      --red: #e63946;
      --green: #2a9d8f;
      --bg: #f3f6f9;
      --surface: #ffffff;
      --text: #1d2d44;
      --text-muted: #64748b;
      --border: #e2e8f0;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --shadow: 0 4px 16px rgba(11, 37, 69, 0.06);
      --shadow-hover: 0 10px 24px rgba(11, 37, 69, 0.1);
      --font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: var(--font);
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    /* Responsive Shell */
    .app-shell {
      width: 100%;
      max-width: 1320px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      position: relative;
    }

    /* Top Navigation */
    header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 50;
      box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }

    .nav-container {
      max-width: 1320px;
      margin: 0 auto;
      padding: 12px 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .nav-top-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }

    .brand-block {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo-badge {
      width: 38px;
      height: 38px;
      background: linear-gradient(135deg, var(--primary), var(--navy));
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 1.25rem;
      font-weight: 800;
    }

    .brand-text h1 {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--navy);
      letter-spacing: -0.3px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .brand-text p {
      font-size: 0.72rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    .meta-tools {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .location-pill {
      display: flex;
      align-items: center;
      gap: 6px;
      background: #f8fafc;
      padding: 6px 12px;
      border-radius: 20px;
      border: 1px solid var(--border);
      font-size: 0.76rem;
      color: var(--navy-light);
      font-weight: 600;
    }

    .trust-pill {
      background: #eef8f6;
      color: var(--green);
      padding: 6px 12px;
      border-radius: 20px;
      font-weight: 700;
      font-size: 0.76rem;
      border: 1px solid #b2dfdb;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .lang-select {
      border: 1px solid var(--border);
      background: white;
      border-radius: 8px;
      font-size: 0.76rem;
      padding: 6px 10px;
      font-weight: 600;
      color: var(--navy);
      cursor: pointer;
      outline: none;
    }

    .help-icon-btn {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 1px solid var(--border);
      background: white;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-weight: 700;
      font-size: 0.85rem;
      color: var(--navy-light);
    }

    /* Role Switcher */
    .role-switcher {
      display: inline-flex;
      background: #edf2f7;
      padding: 4px;
      border-radius: 12px;
      gap: 4px;
      width: 100%;
    }

    .role-btn {
      flex: 1;
      padding: 10px 18px;
      border: none;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.86rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
      background: transparent;
      color: var(--text-muted);
    }

    .role-btn.active {
      background: var(--surface);
      color: var(--navy);
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    @media (min-width: 900px) {
      .nav-container {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 14px 24px;
      }
      .role-switcher {
        width: auto;
      }
      .role-btn {
        flex: initial;
      }
    }

    /* Content Area */
    main {
      flex: 1;
      padding: 16px;
      max-width: 1320px;
      width: 100%;
      margin: 0 auto;
      padding-bottom: 96px;
    }

    @media (min-width: 900px) {
      main {
        padding: 24px;
        padding-bottom: 96px;
      }
    }

    .card {
      background: var(--surface);
      border-radius: var(--radius-md);
      padding: 18px;
      margin-bottom: 16px;
      box-shadow: var(--shadow);
      border: 1px solid var(--border);
    }

    .card-title {
      font-size: 0.88rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--navy);
      margin-bottom: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .dashboard-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
    }

    @media (min-width: 992px) {
      .dashboard-grid {
        grid-template-columns: 420px 1fr;
        gap: 24px;
        align-items: start;
      }
      .org-dashboard-grid {
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        align-items: start;
      }
    }

    /* Service Selector */
    .services-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
      margin-bottom: 16px;
    }

    @media (min-width: 600px) {
      .services-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    .service-card {
      border: 2px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 14px;
      background: #fafbfc;
      cursor: pointer;
      text-align: left;
      transition: all 0.2s ease;
    }

    .service-card:hover, .service-card.selected {
      border-color: var(--primary);
      background: var(--primary-light);
      transform: translateY(-2px);
    }

    .service-card h4 {
      font-size: 0.95rem;
      color: var(--navy);
      margin-bottom: 4px;
    }

    .service-card span {
      font-size: 0.76rem;
      color: var(--text-muted);
      display: block;
    }

    .btn-primary {
      width: 100%;
      background: var(--primary);
      color: white;
      border: none;
      padding: 14px 20px;
      border-radius: var(--radius-md);
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 4px 14px rgba(2, 128, 144, 0.25);
      transition: all 0.2s;
    }

    .btn-primary:hover {
      background: var(--primary-dark);
    }

    .offline-box {
      background: #f8fafc;
      border-left: 4px solid var(--navy-light);
      padding: 12px 14px;
      border-radius: 4px;
      font-size: 0.78rem;
      margin-top: 14px;
      line-height: 1.45;
      cursor: pointer;
      transition: background 0.15s;
    }

    .offline-box:hover {
      background: #edf2f7;
    }

    .offline-box b {
      color: var(--navy);
    }

    /* Live Token Card */
    .token-hero {
      background: linear-gradient(135deg, var(--navy), #14365d);
      color: white;
      border-radius: var(--radius-lg);
      padding: 22px 18px;
      text-align: center;
      position: relative;
      margin-bottom: 16px;
      box-shadow: 0 10px 25px rgba(11, 37, 69, 0.2);
    }

    .token-hero .badge {
      display: inline-block;
      background: rgba(255, 255, 255, 0.15);
      font-size: 0.72rem;
      padding: 4px 12px;
      border-radius: 12px;
      margin-bottom: 10px;
      letter-spacing: 0.5px;
    }

    .my-token-num {
      font-size: 3.4rem;
      font-weight: 800;
      letter-spacing: 1px;
      color: #ffffff;
      line-height: 1;
      margin: 6px 0 10px;
    }

    .token-stats-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      border-top: 1px solid rgba(255, 255, 255, 0.15);
      padding-top: 14px;
      margin-top: 12px;
    }

    .token-stat .val {
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--amber);
    }

    .token-stat .lbl {
      font-size: 0.72rem;
      color: #cfd9e8;
    }

    .confidence-tag {
      font-size: 0.68rem;
      background: rgba(42, 157, 143, 0.35);
      color: #99f6e4;
      padding: 2px 8px;
      border-radius: 8px;
      display: inline-block;
      margin-top: 6px;
    }

    .voice-btn {
      position: absolute;
      top: 16px;
      right: 16px;
      background: rgba(255, 255, 255, 0.2);
      border: none;
      color: white;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.2s;
    }

    .voice-btn:hover {
      background: rgba(255, 255, 255, 0.35);
    }

    /* Free Time Planner */
    .planner-window {
      background: #eef8f6;
      border: 1.5px dashed var(--secondary);
      border-radius: var(--radius-md);
      padding: 16px;
    }

    .free-min-banner {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
    }

    .free-min-banner .clock-icon {
      font-size: 2rem;
    }

    .free-min-title {
      font-size: 1rem;
      font-weight: 800;
      color: var(--navy);
    }

    .activity-chips {
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
    }

    @media (min-width: 600px) and (max-width: 991px), (min-width: 1200px) {
      .activity-chips {
        grid-template-columns: 1fr 1fr;
      }
    }

    .activity-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: white;
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 0.82rem;
      border: 1px solid #d8ece8;
    }

    .act-left {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 600;
    }

    .act-tag {
      font-size: 0.7rem;
      background: #e2e8f0;
      color: #475569;
      padding: 3px 8px;
      border-radius: 6px;
      font-weight: 700;
      white-space: nowrap;
    }

    /* Smart Return Window */
    .return-box {
      border: 1px solid #fed7aa;
      background: #fffaf0;
      border-radius: var(--radius-md);
      padding: 16px;
    }

    .slider-label {
      display: flex;
      justify-content: space-between;
      font-size: 0.78rem;
      font-weight: 600;
      margin-bottom: 6px;
    }

    .progress-bar-wrap {
      width: 100%;
      height: 10px;
      background: #ffedd5;
      border-radius: 10px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, #f4a261, #e76f51);
      width: 70%;
      transition: width 0.4s ease;
    }

    .return-alert-text {
      font-size: 0.8rem;
      color: #9a3412;
      font-weight: 600;
      margin-top: 10px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Peer Token Swap */
    .swap-card {
      border: 1px solid #e0e7ff;
      background: #f5f7ff;
      border-radius: var(--radius-md);
      padding: 16px;
    }

    .swap-flex {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .btn-swap {
      background: #4f46e5;
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s;
    }

    .btn-swap:disabled {
      background: #94a3b8;
      cursor: not-allowed;
    }

    /* Grace Banner */
    .grace-banner {
      background: #fee2e2;
      border: 1px solid #fca5a5;
      color: #991b1b;
      padding: 14px 18px;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      margin-bottom: 16px;
      display: none;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
    }

    .grace-banner.active {
      display: flex;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.8; }
    }

    /* Organisation Metrics */
    .metric-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-bottom: 16px;
    }

    @media (min-width: 600px) {
      .metric-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    .metric-box {
      background: white;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 14px;
      text-align: center;
      box-shadow: var(--shadow);
    }

    .metric-box .num {
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--navy);
    }

    .metric-box .label {
      font-size: 0.72rem;
      color: var(--text-muted);
      margin-top: 3px;
    }

    .counter-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 0;
      border-bottom: 1px solid #f1f5f9;
      font-size: 0.85rem;
    }

    .counter-badge {
      display: inline-block;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      margin-right: 8px;
      cursor: pointer;
    }

    .status-open { background: var(--green); }
    .status-busy { background: var(--amber); }
    .status-closed { background: var(--red); }

    .ai-realloc {
      background: linear-gradient(135deg, #eff6ff, #dbeafe);
      border: 1.5px solid #93c5fd;
      border-radius: var(--radius-md);
      padding: 14px 16px;
      margin-bottom: 16px;
    }

    .ai-realloc h4 {
      font-size: 0.88rem;
      color: #1e40af;
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 4px;
    }

    .ai-realloc p {
      font-size: 0.8rem;
      color: #1e3a8a;
      margin-bottom: 10px;
    }

    .btn-ai-accept {
      background: #2563eb;
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
    }

    /* Peak hour mini chart */
    .chart-container {
      display: flex;
      align-items: flex-end;
      height: 120px;
      gap: 12px;
      padding-top: 15px;
      margin-bottom: 10px;
    }

    .chart-bar-wrap {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      height: 100%;
      justify-content: flex-end;
    }

    .chart-bar {
      width: 100%;
      max-width: 38px;
      background: var(--navy-light);
      border-radius: 6px 6px 0 0;
      transition: height 0.3s;
    }

    .chart-bar.highlight {
      background: var(--secondary);
    }

    .chart-time {
      font-size: 0.7rem;
      color: var(--text-muted);
      margin-top: 6px;
    }

    /* SDG Impact cards */
    .sdg-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
      margin-top: 10px;
    }

    @media (min-width: 480px) {
      .sdg-grid {
        grid-template-columns: 1fr 1fr 1fr;
      }
    }

    .sdg-item {
      background: #f8fafc;
      border-radius: 10px;
      padding: 12px 8px;
      text-align: center;
      border: 1px solid var(--border);
    }

    .sdg-num {
      font-size: 0.7rem;
      font-weight: 800;
      display: inline-block;
      padding: 2px 8px;
      border-radius: 6px;
      color: white;
      margin-bottom: 4px;
    }

    .sdg-9 { background: #f26a2e; }
    .sdg-11 { background: #f89d2a; }
    .sdg-12 { background: #bf8d2c; }

    .sdg-metric {
      font-size: 1.1rem;
      font-weight: 800;
      color: var(--navy);
    }

    .sdg-desc {
      font-size: 0.72rem;
      color: var(--text-muted);
    }

    /* Presentation Demo Bar */
    .demo-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(15, 23, 42, 0.95);
      backdrop-filter: blur(10px);
      border-top: 1px solid #334155;
      padding: 10px 16px;
      z-index: 1000;
      display: flex;
      justify-content: center;
    }

    .demo-bar-inner {
      max-width: 1320px;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .demo-bar-title {
      font-size: 0.76rem;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .demo-buttons {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      max-width: 100%;
      padding-bottom: 2px;
    }

    .demo-btn {
      background: #1e293b;
      color: #f1f5f9;
      border: 1px solid #475569;
      padding: 8px 12px;
      border-radius: 8px;
      font-size: 0.76rem;
      font-weight: 600;
      white-space: nowrap;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 5px;
      transition: background 0.15s;
    }

    .demo-btn:hover {
      background: #334155;
    }

    /* Toast Notification */
    .toast {
      position: fixed;
      top: 20px;
      right: 20px;
      background: #1e293b;
      color: white;
      border-radius: var(--radius-sm);
      padding: 12px 18px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
      font-size: 0.85rem;
      z-index: 2000;
      display: flex;
      align-items: center;
      gap: 12px;
      transform: translateY(-80px);
      opacity: 0;
      transition: all 0.3s ease;
      border-left: 4px solid var(--secondary);
      max-width: 90vw;
    }

    .toast.show {
      transform: translateY(0);
      opacity: 1;
    }

    /* Onboarding Modal */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(11, 29, 51, 0.7);
      backdrop-filter: blur(5px);
      z-index: 1500;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal-card {
      background: white;
      border-radius: var(--radius-lg);
      padding: 24px;
      width: 100%;
      max-width: 440px;
      text-align: center;
      box-shadow: 0 20px 40px rgba(0,0,0,0.25);
      position: relative;
    }

    .step-dots {
      display: flex;
      justify-content: center;
      gap: 6px;
      margin: 14px 0;
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #cbd5e1;
    }

    .dot.active {
      background: var(--primary);
      width: 20px;
      border-radius: 4px;
    }

    .skip-link {
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 0.78rem;
      margin-top: 12px;
      cursor: pointer;
      text-decoration: underline;
    }

    .hidden {
      display: none !important;
    }
  </style>
</head>
<body>

  <!-- Toast Notification -->
  <div id="toast" class="toast">
    <span id="toastIcon">🔔</span>
    <span id="toastMsg">SmartQueue is active</span>
  </div>

  <!-- Onboarding Modal -->
  <div id="onboardingModal" class="modal-overlay">
    <div class="modal-card">
      <div style="font-size: 2.4rem; margin-bottom: 10px;" id="obIcon">⏱️</div>
      <h3 id="obTitle" style="color: var(--navy); margin-bottom: 8px; font-size: 1.2rem;">Don't Wait. Use the Wait.</h3>
      <p id="obDesc" style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.45;">
        SmartQueue converts wasted hall-waiting into productive personal time with real-time return alerts & smart queue swaps.
      </p>
      <div class="step-dots">
        <div class="dot active" id="dot1"></div>
        <div class="dot" id="dot2"></div>
        <div class="dot" id="dot3"></div>
      </div>
      <button class="btn-primary" id="obNextBtn" onclick="nextOnboardingStep()">Next</button>
      <div><button class="skip-link" onclick="dismissOnboarding()">Skip Overview</button></div>
